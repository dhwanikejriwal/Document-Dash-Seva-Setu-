# Copy to deploy/deploy.env (git-ignored) and fill in. Used by `npm run deploy`.

# SSH login for the server (key-based login recommended)
DEPLOY_HOST=your.server.example
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
# Optional private key; leave empty to use your SSH agent / default key
DEPLOY_SSH_KEY=

# URL path the game is served at (must match nothing else on the site)
DEPLOY_BASE_PATH=/document_dash

# Where releases are kept on the server
DEPLOY_APP_DIR=/opt/document_dash
# nginx root that holds the live symlink: the game is served from DEPLOY_WEB_ROOT/document_dash
DEPLOY_WEB_ROOT=/var/www/apps
# Where the generated nginx snippet is installed (include it once in your server block)
DEPLOY_NGINX_SNIPPET=/etc/nginx/snippets/document_dash.conf
# Kiosk login: the admin ID/password file (set with `npm run deploy:admin`) and the kiosk
# cookie's secret token (created on the first deploy). Both live only on the server.
DEPLOY_NGINX_HTPASSWD=/etc/nginx/document_dash.htpasswd
DEPLOY_KIOSK_TOKEN_FILE=/etc/nginx/document_dash.kiosk-token
# Mark the kiosk cookie Secure (https only). Leave empty to decide from DEPLOY_PUBLIC_URL;
# set false if the game is opened over plain http://
DEPLOY_COOKIE_SECURE=
# Releases to keep for rollback
DEPLOY_KEEP_RELEASES=5
# Run privileged steps with sudo (set false if DEPLOY_USER is root)
DEPLOY_USE_SUDO=true

# Optional: public URL to check after deploying, e.g. https://your.server.example/document_dash/
DEPLOY_PUBLIC_URL=
