# Copy to .env.production (or .env.local) and adjust before building for the kiosk.

# Game selection screen that opens this game. When set, the kiosk returns there
# between players. Leave empty to return to this game's own start screen.
VITE_LAUNCHER_URL=

# This game's identifier on generated certificates
VITE_GAME_NAME=Document_Dash

# Certificate service endpoint (defaults to the Rajyotsav certificate API)
# VITE_CERTIFICATE_API_URL=https://cggeomap.cgstate.gov.in/rajyotsav/api/certificate
